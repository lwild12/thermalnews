# Copy to .env and edit: cp .env.example .env
# .env is git-ignored, so the token below never gets committed.

# Printer
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
# starline or escpos (see README step 2)
PRINTER_PROTOCOL=starline
PRINTER_WIDTH_DOTS=576

# Ollama (use the machine's LAN IP, not localhost, when running in Docker)
OLLAMA_URL=http://192.168.1.10:11434
OLLAMA_MODEL=llama3.2

# Sink (leave both empty to print full URLs instead of short links)
SINK_URL=https://s.example.com
SINK_TOKEN=

# Stories
FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://hnrss.org/frontpage
ITEMS_PER_FEED=3
MAX_AGE_HOURS=24
